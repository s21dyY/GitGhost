# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Do NOT put AWS access keys here. AWS credentials come from the default credential chain
# (aws configure / aws sso login / an IAM role in deployment).

# GitHub (server-side only). Optional: raises the rate limit from 60/hour.
GITHUB_TOKEN=

# AWS region. Set explicitly; the code assumes no default.
# Check that your organization allows DynamoDB and Bedrock in the region you pick.
AWS_REGION=us-east-2
# Optional named profile from `aws configure list-profiles` (a name, not an account number).
AWS_PROFILE=

# DynamoDB entity-assignment table (see docs/DYNAMODB_ASSIGNMENTS.md). Not created yet.
# Legacy alias still read by the code: GITGHOST_ASSIGNMENTS_TABLE
DYNAMODB_TABLE=gitghost-entity-assignments

# Bedrock model or inference-profile ID. Converse needs an inference-profile ID for models
# that list only INFERENCE_PROFILE support (for example us.anthropic.claude-haiku-4-5-20251001-v1:0).
# Verify with `aws bedrock list-inference-profiles --region <region>`; do not guess.
BEDROCK_MODEL_ID=

# Must be 1 to allow any live (billable) Bedrock call. Default off.
# Legacy alias still read by the code: GITGHOST_LIVE_BEDROCK
LIVE_GENERATION_ENABLED=0

# ---- Chat cost controls (Milestone 2B). Initial development values, NOT verified production-safe. ----
# Bedrock is OFF by default. Both the flag and the provider must say bedrock for any billable call.
GITGHOST_BEDROCK_ENABLED=false
GITGHOST_CHAT_PROVIDER=mock
# Emergency stop that needs a redeploy. A second, instant kill switch lives in the usage table (docs/COST_CONTROLS.md).
GITGHOST_BEDROCK_KILL_SWITCH=false
GITGHOST_MAX_INPUT_TOKENS=4000
GITGHOST_MAX_OUTPUT_TOKENS=300
GITGHOST_CHAT_REQUESTS_PER_MINUTE=5
GITGHOST_CHAT_REQUESTS_PER_DAY=100
GITGHOST_CHAT_CONCURRENCY=2
GITGHOST_DAILY_BUDGET_USD=1.00
# Required before Bedrock can be used. No default prices are assumed: copy them from the current AWS pricing page.
GITGHOST_BEDROCK_INPUT_USD_PER_MTOK=
GITGHOST_BEDROCK_OUTPUT_USD_PER_MTOK=
# Multiplier on every cost estimate (covers price or token drift). 1 to 10.
GITGHOST_BUDGET_SAFETY_FACTOR=1.25
GITGHOST_CHAT_TIMEOUT_MS=20000
# Shared usage counters (DynamoDB table not created yet). "memory" is for local development only.
GITGHOST_USAGE_TABLE=
GITGHOST_USAGE_STORE=
# Optional: a named AWS profile used ONLY for the Bedrock call and the usage counters (for example the restricted
# role). Identity storage keeps the default credential chain. Leave empty to use the default chain for everything.
GITGHOST_BEDROCK_AWS_PROFILE=
# Live Bedrock tests need BOTH of these in the shell, separate from the runtime flag above.
# GITGHOST_LIVE_BEDROCK_TESTS=1
# GITGHOST_LIVE_BEDROCK_TESTS_ACK=I_ACCEPT_COST

# ---- Client identity for rate limits ----
# none (default): no forwarded header is trusted; all visitors share one "unverified" bucket.
# header: trust ONE header that your host's edge overwrites (set GITGHOST_TRUSTED_IP_HEADER).
# xff-hops: trust the Nth entry from the right of X-Forwarded-For (set GITGHOST_TRUSTED_PROXY_HOPS).
# Verify your host's behavior before enabling either. See docs/COST_CONTROLS.md.
GITGHOST_TRUSTED_IP_SOURCE=none
GITGHOST_TRUSTED_IP_HEADER=
GITGHOST_TRUSTED_PROXY_HOPS=
# Optional secret so stored client keys cannot be reversed by trying every IPv4 address.
GITGHOST_CLIENT_KEY_PEPPER=
