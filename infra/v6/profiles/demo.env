# GitGhost demo profile: up to 8 real model replies per UTC day, for a demo session. NOT loaded automatically.
# Use it in the shell only, e.g.:  set -a; . infra/v6/profiles/demo.env; set +a; npx next start -p 3100
# It does not unlock the shared kill switch (KILL#bedrock in the usage table stays ON until the owner unlocks it).
GITGHOST_CHAT_PROVIDER=bedrock
GITGHOST_BEDROCK_ENABLED=true
GITGHOST_BEDROCK_KILL_SWITCH=false
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_REGION=us-east-2
AWS_PROFILE=default
GITGHOST_BEDROCK_AWS_PROFILE=gitghost-smoke
GITGHOST_BEDROCK_INPUT_USD_PER_MTOK=0.06
GITGHOST_BEDROCK_OUTPUT_USD_PER_MTOK=0.24
GITGHOST_BUDGET_SAFETY_FACTOR=1.5
GITGHOST_DAILY_BUDGET_USD=0.006
GITGHOST_CHAT_REQUESTS_PER_DAY=8
GITGHOST_CHAT_REQUESTS_PER_MINUTE=2
GITGHOST_CHAT_CONCURRENCY=1
GITGHOST_MAX_INPUT_TOKENS=4000
GITGHOST_MAX_OUTPUT_TOKENS=500
GITGHOST_CHAT_TIMEOUT_MS=20000
GITGHOST_USAGE_STORE=dynamodb
GITGHOST_USAGE_TABLE=gitghost-usage-counters
GITGHOST_TRUSTED_IP_SOURCE=none
